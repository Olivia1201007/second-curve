{
  "name": "second-curve",
  "version": "4.1.1",
  "private": false,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint app lib tests --ext .ts,.tsx",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs,ts,mts,md}\" \".github/workflows/*.yml\" \"src-tauri/**/*.json\" \"eslint.config.mjs\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs,ts,mts,md}\" \".github/workflows/*.yml\" \"src-tauri/**/*.json\" \"eslint.config.mjs\"",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/network": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@tauri-apps/api": "^2.12.5",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
