# Reference only: export these variables in your shell or hosting service.
# The server does not automatically load this file.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
# Optional extra model IDs in the existing model selector:
# OPENAI_MODELS=gpt-4.1-mini,gpt-4.1
# PORT=8787
# OPENAI_MAX_OUTPUT_TOKENS=4096
# OPENAI_MAX_INPUT_CHARS=500000
# OPENAI_MAX_RESPONSE_BYTES=16777216

# Public deployments must set these values. APP_ORIGIN must be the exact
# HTTPS origin, and the access credentials should only be entered in the host's
# secret environment-variable settings.
# HOST=0.0.0.0
# APP_ORIGIN=https://your-service.onrender.com
# APP_ACCESS_USERNAME=reviewer
# APP_ACCESS_PASSWORD=use-a-unique-long-password
# PUBLIC_VISITOR_MODE=false
#
# For account-free public browsing and AI, set PUBLIC_VISITOR_MODE=true.
# Management paths remain protected by the access credentials above.
